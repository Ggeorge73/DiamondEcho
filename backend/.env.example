# Obtain feed approval and server credentials through VPR and each MLS. Never put
# these values in frontend REACT_APP_* variables or commit a populated .env file.
MAPBOX_ACCESS_TOKEN=
RENTCAST_API_KEY=
UNDERWRITING_INTEREST_RATE=7.25

# Deployed frontend / edge proxy origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GAMLS_MLS_ENABLED=false
GAMLS_MLS_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData
GAMLS_MLS_DATASET_ID=
GAMLS_MLS_SERVER_TOKEN=
GAMLS_MLS_ATTRIBUTION=Georgia MLS
GAMLS_MLS_DISCLAIMER=
GAMLS_MLS_LOGO_URL=

FMLS_MLS_ENABLED=false
FMLS_MLS_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData
FMLS_MLS_DATASET_ID=
FMLS_MLS_SERVER_TOKEN=
FMLS_MLS_ATTRIBUTION=First Multiple Listing Service
FMLS_MLS_DISCLAIMER=
FMLS_MLS_LOGO_URL=

# Generic RESO OAuth alternative (per-provider) when a server token is not issued:
# GAMLS_MLS_TOKEN_URL=
# GAMLS_MLS_CLIENT_ID=
# GAMLS_MLS_CLIENT_SECRET=
# GAMLS_MLS_SCOPE=

MLS_CACHE_TTL_SECONDS=300
MLS_PUBLIC_REQUESTS_PER_MINUTE=120
MLS_SYNC_API_KEY=replace-with-a-long-random-server-only-value
