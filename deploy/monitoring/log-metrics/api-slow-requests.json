{
  "name": "diamondecho_sre_api_slow_requests",
  "description": "DiamondEcho SRE: API requests slower than OBSERVABILITY_SLOW_MS (default 1000 ms), counted from the one log line backend/observability writes for each. Label: the route template.",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"diamondecho-api\" AND logName=\"projects/${PROJECT_ID}/logs/run.googleapis.com%2Fstdout\" AND jsonPayload.event=\"request.slow\"",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "displayName": "DiamondEcho SRE: API slow requests",
    "labels": [
      { "key": "route", "valueType": "STRING", "description": "Route template, for example /api/v1/deals/analyze" }
    ]
  },
  "labelExtractors": {
    "route": "EXTRACT(jsonPayload.route)"
  }
}
